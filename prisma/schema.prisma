generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Order {
  id                String    @id @default(cuid())
  orderId           String    @unique // e.g., FTF-2026-0001
  customerName      String
  email             String
  phone             String
  deliveryMethod    String    // "home_delivery" | "pickup"
  region            String?
  city              String?
  area              String?
  streetAddress     String?
  notes             String?
  momoProvider      String?   // "mtn" | "vod" | "tgo"
  momoPhone         String?
  items             Json      // [{ productId, name, price, quantity }]
  subtotal          Int       // in pesewas
  deliveryFee       Int       // in pesewas
  total             Int       // in pesewas
  currency          String    @default("GHS")
  paymentStatus     String    @default("pending") // pending | paid | failed | refunded
  paymentReference  String?
  channel           String?   // mobile_money | card | bank_transfer
  fulfillmentStatus String    @default("pending") // pending | processing | shipped | delivered | picked_up
  paidAt            DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([paymentStatus])
  @@index([fulfillmentStatus])
  @@index([createdAt])
}
