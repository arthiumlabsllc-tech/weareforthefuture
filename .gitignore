# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# images (served from Cloudinary CDN)
/public/images/
!/public/images/misc/ftf-logo-ico.png

# cloudinary upload mapping
cloudinary-map.json

# upload scripts
/scripts/*
!/scripts/sync-future-pathways.ts
!/scripts/verify-future-pathways.mjs
!/scripts/seed-pillars.ts
!/scripts/check-banned-language.mjs
!/scripts/sweep-legacy-copy.ts

# local build / server logs and CDP screenshot captures (never commit)
*.build-log.txt
*.start-log.txt
.phase*-shots/
.cdp-profile*/

# throwaway DB probes + CDP screenshot drivers (live at workspace root, never commit)
_probe-*.ts
.dbprobe.mjs
*.probe.*
cdp-*.mjs
