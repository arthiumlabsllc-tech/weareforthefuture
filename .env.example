# ============================================
# FTF Website - Environment Variables
# ============================================
# Copy this file to .env.local and fill in the values
# Then also create a .env file with DATABASE_URL for Prisma

# ──── Database (Neon PostgreSQL) ────
# Get your connection string from: https://console.neon.tech
DATABASE_URL="postgresql://user:password@localhost:5432/ftf_db?schema=public"

# ──── Admin Auth ────
# Generate a strong random string for production (e.g., openssl rand -base64 32)
ADMIN_JWT_SECRET="change-me-to-a-strong-random-string"

# ──── Admin Secret Key (legacy API compatibility) ────
NEXT_PUBLIC_ADMIN_KEY="your-admin-key-here"

# ──── Paystack ────
# Get your keys from: https://dashboard.paystack.com/#/settings/developer
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_test_xxxxx"
PAYSTACK_SECRET_KEY="sk_test_xxxxx"

# ──── Cloudinary (for file uploads) ────
# Get from: https://cloudinary.com/console
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ──── Resend (email) ────
# Get from: https://resend.com/api-keys
RESEND_API_KEY=""
RESEND_FROM_EMAIL="noreply@ftf.org"
